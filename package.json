{
  "name": "ora_explain_plan_viz",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "APP_BASE_PATH=/ora-explain-plan-viz/ APP_ANALYTICS=1 npm run build",
    "build:single": "tsc -b && vite build --mode single",
    "build:site-css": "npx -y tailwindcss@3.4.19 -c scripts/site/tailwind.config.cjs -i scripts/site/tailwind.css -o site/assets/site.css --minify",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "build:core": "node packages/ora-plan-core/scripts/build.mjs",
    "pretest": "npm run build:core",
    "test": "vitest run --environment jsdom",
    "eval:repro": "tsx evals/run.ts",
    "eval:analyze": "tsx evals/analyze.ts",
    "preview": "vite preview",
    "docker:build": "docker build -t ora-explain-plan-viz .",
    "docker:run": "docker run --rm -p 8080:80 ora-explain-plan-viz",
    "docker:compose:up": "docker compose up --build",
    "docker:compose:down": "docker compose down"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@dagrejs/dagre": "^1.1.8",
    "@tanstack/react-virtual": "^3.14.26",
    "@xyflow/react": "^12.12.1",
    "d3-sankey": "^0.12.3",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "lz-string": "^1.5.0",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.4",
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "oracledb": "^7.0.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
